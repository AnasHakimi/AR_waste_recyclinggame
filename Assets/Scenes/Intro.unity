MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1406108053}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 09fc988f0d9c53346be082917a6330b3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 2000897295}
  voiceAudioSource: {fileID: 1384354496}
  sfxAudioSource: {fileID: 2034353964}
  typingSpeed: 0.05
  nextButton: {fileID: 485464116}
  prevButton: {fileID: 239076449}
  audioButton: {fileID: 1851760927}
  skipButton: {fileID: 801943495}
  dialogueLines:
  - "Hello there! I\u2019m so glad you are here!"
  - Hi. I am Genius Bot, your recycling buddy!
  - "In this app, you\u2019ll explore how to recycle different types of waste."
  - Cool! But how will I learn that?
  - "Great question! You\u2019ll use your camera to scan the markers"
  - Wow! So I just point my camera and learn what to do?
  - "That\u2019s right! We\u2019ll also play games, answer fun quizzes, and unlock
    recycling facts along the way."
  - "By the end, you\u2019ll be a Recycling Hero. Ready to keep your world clean
    and green!"
  - "Awesome! I can\u2019t wait to become a Recycling Hero!"
  - Are you ready? let's get started.
  - Enjoy! and have fun learning about waste recycling.
  voiceClips:
  - {fileID: 8300000, guid: d78f9266e93594a4fb4bb67fec634b2e, type: 3}
  - {fileID: 8300000, guid: 56bd81013c62fba47a7dd317f34e40f7, type: 3}
